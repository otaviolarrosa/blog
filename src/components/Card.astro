---
import type { CollectionEntry } from 'astro:content';
import { formatDatePtBr } from '../utils/date';
import { getReadingTime } from '../utils/readingTime';
import { withBase } from '../utils/url';

interface Props {
  post: CollectionEntry<'posts'>;
  variant?: 'h2' | 'h3';
}

const { post, variant: Heading = 'h2' } = Astro.props;
const { title, description, pubDate } = post.data;
const readingTime = getReadingTime(post.body ?? '');
---

<li class="post-card">
  <a href={withBase(`/posts/${post.id}/`)} class="group block">
    <Heading class="card-title group-hover:text-accent">{title}</Heading>
    <p class="card-desc">{description}</p>
  </a>
  <div class="card-meta">
    <time datetime={pubDate.toISOString()}>{formatDatePtBr(pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime}</span>
  </div>
</li>

<style>
  .post-card {
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--border);
  }
  .post-card:last-child {
    border-bottom: 0;
  }
  .card-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.25;
    font-weight: 600;
    text-wrap: balance;
    transition: color 120ms;
  }
  .card-desc {
    margin-top: 0.4rem;
    color: var(--fg-muted);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .card-meta {
    font-family: var(--font-ui);
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
</style>
