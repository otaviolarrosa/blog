---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { withBase } from '../../utils/url';

export const getStaticPaths = (async () => {
  const posts = (await getCollection('posts', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const uniqueTags = Array.from(new Set(posts.flatMap((post) => post.data.tags)));

  return uniqueTags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  tag: string;
  posts: CollectionEntry<'posts'>[];
}

const { tag, posts } = Astro.props;
const count = posts.length;
---

<BaseLayout
  title={`Artigos com #${tag}`}
  description={`Todos os artigos com a tag “${tag}”.`}
>
  <main id="main-content" class="app-layout pb-12">
    <div class="max-w-measure mx-auto pt-10 sm:pt-14">
      <nav class="ui-font text-muted-foreground mb-4 text-xs" aria-label="Navegação estrutural">
        <a href={withBase('/tags/')} class="hover:text-accent underline underline-offset-4">Tags</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span aria-current="page">#{tag}</span>
      </nav>

      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">#{tag}</h1>
      <p class="text-muted-foreground mt-3 mb-8 text-lg italic">
        {count} {count === 1 ? 'artigo encontrado' : 'artigos encontrados'}.
      </p>

      <ul>
        {posts.map((post) => (
          <Card post={post} variant="h2" />
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>
