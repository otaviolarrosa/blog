---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDatePtBr } from '../utils/date';
import { getReadingTime } from '../utils/readingTime';
import { withBase } from '../utils/url';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const searchIndex = posts.map((post) => {
  const plainBody = (post.body ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/[#>*_`[\]()!-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  return {
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags,
    date: formatDatePtBr(post.data.pubDate),
    readingTime: getReadingTime(post.body ?? ''),
    url: withBase(`/posts/${post.id}/`),
    body: plainBody,
  };
});
---

<BaseLayout
  title="Buscar"
  description="Busque artigos publicados no blog de Otávio Larrosa por título, tag ou conteúdo."
>
  <main id="main-content" class="app-layout pb-12">
    <div class="max-w-measure mx-auto pt-10 sm:pt-14">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Buscar</h1>
      <p class="text-muted-foreground mt-3 mb-6 text-lg italic">
        Pesquise por título, tag ou conteúdo nos {posts.length} artigos publicados.
      </p>

      <div class="search-box">
        <label for="search-input" class="sr-only">Buscar artigos</label>
        <input
          id="search-input"
          type="search"
          placeholder="Digite para buscar (ex.: .NET, C#, Copilot, MCP)..."
          autocomplete="off"
          autofocus
        />
      </div>

      <p id="search-status" class="ui-font text-muted-foreground mt-4 text-xs" aria-live="polite"></p>

      <ul id="search-results" class="mt-4"></ul>
    </div>
  </main>

  <script id="search-data" type="application/json" is:inline set:html={JSON.stringify(searchIndex)} />
</BaseLayout>

<style>
  .search-box input {
    width: 100%;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--fg);
    transition: border-color 120ms;
  }
  .search-box input::placeholder {
    color: var(--fg-muted);
    opacity: 0.8;
  }
  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
  }
</style>

<style is:global>
  #search-results .post-card {
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--border);
  }
  #search-results .post-card:last-child {
    border-bottom: 0;
  }
  #search-results .card-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.25;
    font-weight: 600;
    color: var(--fg);
    transition: color 120ms;
  }
  #search-results .post-card a:hover .card-title {
    color: var(--accent);
  }
  #search-results .card-desc {
    margin-top: 0.4rem;
    color: var(--fg-muted);
    line-height: 1.55;
  }
  #search-results .card-meta {
    font-family: var(--font-ui);
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
</style>

<script is:inline>
  (() => {
    const dataEl = document.getElementById('search-data');
    const input = document.getElementById('search-input');
    const statusEl = document.getElementById('search-status');
    const resultsEl = document.getElementById('search-results');
    if (!dataEl || !input || !statusEl || !resultsEl) return;

    const posts = JSON.parse(dataEl.textContent || '[]');

    function escapeHtml(str) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function normalize(str) {
      return str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function render(query) {
      const q = normalize(query.trim());
      if (!q) {
        resultsEl.innerHTML = '';
        statusEl.textContent = '';
        return;
      }

      const terms = q.split(/\s+/).filter(Boolean);
      const matches = posts.filter((post) => {
        const haystack = normalize(
          `${post.title} ${post.description} ${post.tags.join(' ')} ${post.body}`,
        );
        return terms.every((term) => haystack.includes(term));
      });

      if (matches.length === 0) {
        statusEl.textContent = `Nenhum artigo encontrado para “${query.trim()}”.`;
        resultsEl.innerHTML = '';
        return;
      }

      statusEl.textContent = `${matches.length} ${
        matches.length === 1 ? 'artigo encontrado' : 'artigos encontrados'
      }.`;

      resultsEl.innerHTML = matches
        .map(
          (p) => `
          <li class="post-card">
            <a href="${escapeHtml(p.url)}" class="block">
              <h2 class="card-title">${escapeHtml(p.title)}</h2>
              <p class="card-desc">${escapeHtml(p.description)}</p>
            </a>
            <div class="card-meta">
              <span>${escapeHtml(p.date)}</span>
              <span aria-hidden="true">·</span>
              <span>${escapeHtml(p.readingTime)}</span>
              ${
                p.tags.length
                  ? `<span aria-hidden="true">·</span><span>${p.tags
                      .map((t) => `#${escapeHtml(t)}`)
                      .join(' ')}</span>`
                  : ''
              }
            </div>
          </li>`,
        )
        .join('');
    }

    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') || '';
    if (initialQuery) {
      input.value = initialQuery;
      render(initialQuery);
    }

    input.addEventListener('input', () => {
      const value = input.value;
      const url = new URL(window.location.href);
      if (value.trim()) {
        url.searchParams.set('q', value);
      } else {
        url.searchParams.delete('q');
      }
      window.history.replaceState({}, '', url);
      render(value);
    });
  })();
</script>
